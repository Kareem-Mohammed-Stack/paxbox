{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .lumin-contact {
    max-width: 70rem;
    margin: auto;
  }
  .contact-heading-{{ section.id }} {
      text-align: {{ section.settings.heading_align }};
      {%- if section.settings.sub_heading == blank -%}
     max-width: 70rem;
     {% endif %}
      margin: auto;
  }
  .contact-sub-heading-{{ section.id }}{
      text-align: {{ section.settings.sub_heading_align }};
  }
  .contact-sub-heading-{{ section.id }} p {
      margin-top: 0;
  }
  .contact-wrapper-{{ section.id }} {
     {%- if section.settings.sub_heading != blank -%}
    display: grid;
    {% endif %}
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 5rem;
    margin-top: 2rem;
  }
  
   @media screen and (max-width: 749px) {
     .contact-wrapper-{{ section.id }} {
    gap: 3rem;
  }
    .contact-heading-{{ section.id }}{
      text-align: {{ section.settings.heading_align_mobile }};
  }
     .contact-sub-heading-{{ section.id }}{
      text-align: {{ section.settings.sub_heading_align_mobile }};
  }
     
  }

  /* Contact Email Card Styles */
  .contact-email-card {
    max-width: 620px;
    margin: 24px auto 0 auto;
    background: #ffffff;
    border: 1px solid #eaedf5;
    border-radius: 20px;
    padding: 48px 36px;
    text-align: center;
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0, 0, 0, 0.02);
  }

  .contact-email-card__icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(0, 69, 255, 0.08);
    color: #0045ff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px auto;
  }

  .contact-email-card__title {
    font-size: 24px;
    font-weight: 800;
    color: #111827;
    margin: 0 0 10px 0;
  }

  .contact-email-card__desc {
    font-size: 15px;
    color: #4b5563;
    line-height: 1.65;
    margin: 0 0 28px 0;
  }

  .contact-email-card__box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 18px 24px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
  }

  .contact-email-card__label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #64748b;
  }

  .contact-email-card__link {
    font-size: 19px;
    font-weight: 800;
    color: #0045ff;
    text-decoration: none;
    word-break: break-all;
    transition: color 0.2s ease;
  }

  .contact-email-card__link:hover {
    color: #0036cc;
    text-decoration: underline;
  }

  .contact-email-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 320px;
    height: 48px;
    background-color: #0045ff !important;
    color: #ffffff !important;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    margin: 0 auto 24px auto;
    box-shadow: 0 4px 14px rgba(0, 69, 255, 0.3);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .contact-email-card__btn:hover {
    background-color: #0036cc !important;
    transform: translateY(-2px);
  }

  .contact-email-card__meta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 13px;
    color: #64748b;
  }

  @media screen and (max-width: 640px) {
    .contact-email-card {
      padding: 32px 20px;
      margin: 10px auto 0 auto;
    }
    .contact-email-card__title {
      font-size: 20px;
    }
    .contact-email-card__link {
      font-size: 16px;
    }
  }
</style>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="contact-heading-{{ section.id }} title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading | replace: '[', '<span class="lumin-text__fancy1">' | replace: ']', '</span>' | replace: '((', '<span class="lumin-text__fancy2">' | replace: '))', '</span>' }}
      </h2>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- endif -%}
    {%- if section.blocks.size == 0 -%}
      <div class="contact-email-card">
        <div class="contact-email-card__icon">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </div>
        <h3 class="contact-email-card__title">We'd Love to Hear from You</h3>
        <p class="contact-email-card__desc">
          Have a question about your order, tracking, or need assistance? Our customer care team is available 24/7 to assist you.
        </p>
        <div class="contact-email-card__box">
          <span class="contact-email-card__label">Contact us at this email:</span>
          <a href="mailto:{{ section.settings.contact_email | default: 'Paxboxs.ramy@gmail.com' }}" class="contact-email-card__link">
            {{ section.settings.contact_email | default: 'Paxboxs.ramy@gmail.com' }}
          </a>
        </div>
        <a href="mailto:{{ section.settings.contact_email | default: 'Paxboxs.ramy@gmail.com' }}" class="contact-email-card__btn">
          Send Email Now
        </a>
        <div class="contact-email-card__meta">
          <span class="meta-item">⚡ Typical response within 24 hours</span>
          <span class="meta-item">🕒 Monday – Sunday: 24/7 Customer Care</span>
        </div>
      </div>
    {%- else -%}
      <div class="contact-wrapper-{{ section.id }}">
        {%- if section.settings.sub_heading != blank -%}
        <div class="contact-sub-heading-{{ section.id }}">
          {{ section.settings.sub_heading }}</div>
        {% endif %}
        <div>
        {%- liquid
          assign contact_form_class = 'isolate'
          if settings.animations_reveal_on_scroll
            assign contact_form_class = 'isolate scroll-trigger animate--slide-in lumin-contact'
          endif
        -%}
        {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
          {%- if form.posted_successfully? -%}
            <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {% render 'icon-success' %}
              {{ 'templates.contact.form.post_success' | t }}
            </h2>
          {%- elsif form.errors -%}
            <div class="form__message">
              <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                {% render 'icon-error' %}
                {{ 'templates.contact.form.error_heading' | t }}
              </h2>
            </div>
            <ul class="form-status-list caption-large" role="list">
              <li>
                <a href="#ContactForm-email" class="link">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </a>
              </li>
            </ul>
          {%- endif -%}

          {% for block in section.blocks %}
        {%- case block.type -%}
              {%- when 'name' -%}
        <div class="field">
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="ContactForm-name"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="{{ 'templates.contact.form.name' | t }}"
          >
          <label class="field__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
        </div>
           {%- when 'email' -%}
        <div class="field field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder="{{ 'templates.contact.form.email' | t }}"
          >
          <label class="field__label" for="ContactForm-email">
            {{- 'templates.contact.form.email' | t }}
            <span aria-hidden="true">*</span></label
          >
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                {%- render 'icon-error' -%}
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>
           {%- when 'tel' -%}
      <div class="field">
        <input
          type="tel"
          id="ContactForm-phone"
          class="field__input"
          autocomplete="tel"
          name="contact[{{ 'templates.contact.form.phone' | t }}]"
          pattern="[0-9\-]*"
          value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          placeholder="{{ 'templates.contact.form.phone' | t }}"
        >
        <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
      </div>
        {%- when 'date' -%}
      <div class="field">
      <input 
        type="date"  
        placeholder="Select your date" 
        id="ContactForm-date" 
        class="field__input" 
        name="contact[date]" 
        value="2024-06-16"
        >
      <label class="form__label field__label" for="ContactForm-date" style="margin-bottom: 0.2rem;top: 10px;">Select your date</label>
      </div>
          {%- when 'select' -%}
      <div class="field">
        <select class="field__input" name="contact[{{ block.settings.select_id }}]" id="ContactForm-select-{{ block.id }}" style="padding: 1.8rem 1.5rem .8rem 2rem;">
            <option value="option-1" selected="true" id="ContactForm-select-0">{{ block.settings.option_1 }}</option>
            <option value="option-2" id="ContactForm-select-1">{{ block.settings.option_2 }}</option>
            {% if block.settings.show_option_3 %}<option value="option-3" id="ContactForm-select-2">{{ block.settings.option_3 }}</option>{% endif %}
            {% if block.settings.show_option_4 %}<option value="option-4" id="ContactForm-select-3">{{ block.settings.option_4 }}</option>{% endif %}
        </select>
           <svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6" style="width: 16px;position: absolute;right: 16px;top: 40%;"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"></path></svg>
      <label class="form__label field__label" for="ContactForm-select-{{ block.id }}" style="margin-bottom: 0.2rem;top: 10px;">{{ block.settings.option_label }}</label>
      </div>
       {%- when 'textarea' -%}
      <div class="field">
        <textarea
          rows="10"
          id="ContactForm-body"
          class="text-area field__input"
          name="contact[{{ 'templates.contact.form.comment' | t }}]"
          placeholder="{{ 'templates.contact.form.comment' | t }}"
        >
          {{- form.body -}}
        </textarea>
        <label class="form__label field__label" for="ContactForm-body">
          {{- 'templates.contact.form.comment' | t -}}
        </label>
      </div>
           {%- when 'text' -%}
      <div class="field">
        <input 
          type="text" 
          id="ContactForm-text-{{ block.id }}"
          name="contact[{{ block.settings.text }}]"
          class="field__input"
          size="30" 
          placeholder="{{ block.settings.text_label }}"
          >
        <label class="form__label field__label" for="ContactForm-text-{{ block.id }}">
          {{ block.settings.text_label }}
        </label>
      </div>
          {% endcase %}
        {% endfor %}
      <div class="contact__button">
        <button type="submit" class="button">
          {{ 'templates.contact.form.send' | t }}
        </button>
      </div>
    {%- endform -%}
   </div>
    </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
   "disabled_on": {
  "groups": ["header", "footer", "custom.popup"]
   },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Contact form",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text_alignment",
      "id": "heading_align",
      "label": "Alignment",
      "default": "center"
    },
     {
      "type": "text_alignment",
      "id": "heading_align_mobile",
      "label": "Alignment – Mobile",
      "default": "center"
    },
    {
      "type": "richtext",
      "id": "sub_heading",
      "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
      "label": "Heading"
    },
    {
      "type": "text_alignment",
      "id": "sub_heading_align",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "sub_heading_align_mobile",
      "label": "Alignment – Mobile",
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "Paxboxs.ramy@gmail.com"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
   "blocks": [
    {
      "type": "name",
      "name": "Name",
      "limit": 1
    },
     {
      "type": "email",
      "limit": 1,
      "name": "Email"
    },
     {
      "type": "textarea",
       "limit": 1,
      "name": "Text Box"
    },
     {
      "type": "tel",
       "limit": 1,
      "name": "Telephone"
    },
     {
      "type": "date",
      "limit": 1,
      "name": "Date"
    },
      {
      "type": "text",
      "name": "Text field",
       "settings": [
              {
      "type": "text",
       "id": "text_label",
      "label": "Placeholder text",
      "default": "Write something"
     },
         {
      "type": "text",
       "id": "text",
      "label": "Name",
      "default": "Text",
      "info": "Only you can see this when recieve form"
     }
       ]
      },
     {
      "type": "select",
      "name": "Dropdown",
       "settings": [
             {
      "type": "text",
       "id": "select_id",
      "label": "Name",
      "default": "select",
      "info": "Only you can see this when recieve form"
     },
              {
      "type": "text",
       "id": "option_label",
      "label": "Placeholder text",
      "default": "Select your option"
     },
         {
      "type": "text",
      "id": "option_1",
      "label": "Option 1",
      "default": "Option 1"
     },
      {
      "type": "text",
       "id": "option_2",
      "label": "Option 2",
      "default": "Option 2"
     },
     {
       "type": "checkbox",
       "id": "show_option_3",
       "default": false,
       "label": "Show Option 3"
     },
           {
      "type": "text",
       "id": "option_3",
      "label": "Option 3",
      "default": "Option 3"
     },
          {
       "type": "checkbox",
       "id": "show_option_4",
       "default": false,
       "label": "Show Option 4"
     },
           {
      "type": "text",
       "id": "option_4",
      "label": "Option 4",
      "default": "Option 4"
     }
       ]
    }
   ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name",
       "blocks": [
        {
          "type": "name"
        },
        {
          "type": "email"
        },
        {
          "type": "tel"
        },
         {
          "type": "textarea"
        }
      ]
    }
  ]
}
{% endschema %}
