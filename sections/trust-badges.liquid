  </svg>
{% endcapture %}

{% capture svg_example_4 %}
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
  </svg>
{% endcapture %}

<div class="section-{{ section.id }} feature-{{ section.id }}" style="background-color:{{ section.settings.background_color }}; background-image: {{ section.settings.background_gradient }};">
    <div class="section-{{ section.id }}-settings ">
      <div class="wrapper-box">
          {%- for block in section.blocks -%}
              {%- assign badge_url = block.settings.feature_url -%}
              {%- if badge_url == blank -%}
                {%- if block.settings.feature_title contains 'Shipping' -%}
                  {%- assign badge_url = shop.shipping_policy.url | default: '/policies/shipping-policy' -%}
                {%- elsif block.settings.feature_title contains 'Return' -%}
                  {%- assign badge_url = shop.refund_policy.url | default: '/policies/refund-policy' -%}
                {%- elsif block.settings.feature_title contains 'Price' -%}
                  {%- assign badge_url = '/collections/all' -%}
                {%- elsif block.settings.feature_title contains 'Rated' or block.settings.feature_title contains 'Star' -%}
                  {%- assign badge_url = '#testimonials-section' -%}
                {%- endif -%}
              {%- endif -%}
              <{% if badge_url != blank %}a href="{{ badge_url }}" style="text-decoration: none; color: inherit;"{% else %}div{% endif %} class="box">
                  {% unless block.settings.hide_image %}
                  <div class="box__image">
                      {%- if block.settings.feature_image != blank -%}
                        <img
                          src="{{ block.settings.feature_image | image_url: width: 100 }}"
                          alt="feature-item-{{ forloop.index }}"
                          width="{{ block.settings.feature_image.width | default: 52 }}"
                          height="{{ block.settings.feature_image.height | default: 52 }}"
                          loading="lazy"
                        >
                      {%- else -%}
                       {% case forloop.index %}
                        {% when 1 %}
                          {{ svg_example_1 }}
                        {% when 2 %}
                          {{ svg_example_2 }}
                        {% when 3 %}
                          {{ svg_example_3 }}
                        {% when 4 %}
                          {{ svg_example_4 }}
                        {% else %}
                          {{ svg_example_1 }}
                        {% endcase %}
                      {%- endif -%}
                  </div>
                  {% endunless %}
                  <div class="box__content-wrapper">
                      <div class="box__title">{{ block.settings.feature_title }}</div>
                      <div class="box__description">{{ block.settings.feature_text }}</div>
                  </div>
              </{% if badge_url != blank %}a{% else %}div{% endif %}>
          {%- endfor -%}
      </div>
  </div>
</div>

