{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .best-sellers-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: stretch;
  }

  @media screen and (max-width: 989px) {
    .best-sellers-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: 14px;
    }
  }

  .best-seller-item {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .best-seller-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  .best-seller-card__media-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 100%; /* 1:1 Aspect Ratio */
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    background: #000000;
    flex-shrink: 0;
  }

  .best-seller-card__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .best-seller-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .best-seller-card:hover .best-seller-card__media img {
    transform: scale(1.03);
  }

  .best-seller-card__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #0045ff;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 6px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    box-shadow: 0 2px 6px rgba(0, 69, 255, 0.25);
    z-index: 2;
  }

  .best-seller-card__info {
    padding-top: 14px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    width: 100%;
  }

  .best-seller-card__title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 8px;
    color: rgb(var(--color-foreground));
    text-align: center;
    text-decoration: none;
    height: auto;
    min-height: 0;
    max-height: none;
    overflow: visible;
    display: block;
    width: 100%;
  }

  .best-seller-card__title a {
    color: inherit;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    word-break: break-word;
    overflow-wrap: anywhere;
    width: 100%;
    line-height: 1.35;
    height: auto;
    max-height: none;
  }

  .best-seller-card__title a:hover {
    text-decoration: underline;
  }

  .best-seller-card__price-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 15px;
    height: 26px;
    margin-top: 6px;
  }

  .best-seller-card__price-compare {
    color: #0045ff;
    text-decoration: line-through;
    font-weight: 600;
  }

  .best-seller-card__price-sale {
    color: rgb(var(--color-foreground));
    font-weight: 700;
  }

  .best-seller-card__action {
    width: 100%;
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    justify-content: center;
  }

  .best-seller-card__buy-form {
    width: 100%;
    margin: 0;
  }

  .best-seller-card__buy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 44px;
    background-color: #0045ff !important;
    color: #ffffff !important;
    border: none;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 69, 255, 0.28);
    transition: background-color 0.2s ease, transform 0.1s ease, box-shadow 0.2s ease;
  }

  .best-seller-card__buy-btn:hover {
    background-color: #003cd6 !important;
    box-shadow: 0 6px 18px rgba(0, 69, 255, 0.42);
    transform: translateY(-2px);
    color: #ffffff !important;
  }

  .best-seller-card__buy-btn:active {
    transform: translateY(0);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin" style="justify-content: {% if section.settings.title_center %}center{% else %}flex-start{% endif %}; text-align: {% if section.settings.title_center %}center{% else %}left{% endif %}; margin-bottom: 28px;">
        <h2 class="inline-richtext {{ section.settings.heading_size }}" style="width: 100%; margin: 0; font-weight: 800;">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}

    {%- liquid
      assign prod_limit = section.settings.products_to_show | default: 4
      assign source_collection = section.settings.collection
      if source_collection == blank or source_collection.products_count == 0
        assign source_collection = collections.all
      endif

      assign use_collection_products = false
      if source_collection != blank and source_collection.products_count > 0
        assign use_collection_products = true
      endif

      assign valid_block_count = 0
      for block in section.blocks
        if block.settings.product != blank
          assign valid_block_count = valid_block_count | plus: 1
        endif
      endfor
    -%}

    <ul class="best-sellers-grid-{{ section.id }}" role="list">
      {%- if valid_block_count > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign product = block.settings.product
            if product == blank
              continue
            endif

            assign title = block.settings.title | default: product.title
            assign link = block.settings.link | default: product.url
            assign price = block.settings.price
            if price == blank
              assign price = product.price | money
            endif

            assign compare_at_price = block.settings.compare_at_price
            if compare_at_price == blank and product.compare_at_price > product.price
              assign compare_at_price = product.compare_at_price | money
            endif

            assign badge = block.settings.badge_text
            if badge == blank and product.compare_at_price > product.price
              assign save_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
              assign badge = '✦ SAVE ' | append: save_pct | append: '%'
            endif

            assign image_asset = block.settings.image_asset
            assign custom_image = block.settings.image
          -%}
          <li class="best-seller-item" {{ block.shopify_attributes }}>
            <div class="best-seller-card">
              <a href="{{ link }}" class="best-seller-card__media-wrapper" aria-label="{{ title | escape }}">
                {%- if badge != blank -%}
                  <span class="best-seller-card__badge">{{ badge }}</span>
                {%- endif -%}
                <div class="best-seller-card__media">
                  {%- if product.featured_image != blank -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | default: title | escape }}"
                      loading="lazy"
                      width="{{ product.featured_image.width }}"
                      height="{{ product.featured_image.height }}"
                    >
                  {%- elsif custom_image != blank -%}
                    <img
                      src="{{ custom_image | image_url: width: 600 }}"
                      alt="{{ title | escape }}"
                      loading="lazy"
                      width="{{ custom_image.width }}"
                      height="{{ custom_image.height }}"
                    >
                  {%- elsif image_asset != blank -%}
                    <img
                      src="{{ image_asset | asset_url }}"
                      alt="{{ title | escape }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              </a>
              <div class="best-seller-card__info">
                <h3 class="best-seller-card__title">
                  <a href="{{ link }}">{{ title }}</a>
                </h3>
                <div class="best-seller-card__price-wrapper">
                  {%- if compare_at_price != blank -%}
                    <span class="best-seller-card__price-compare">{{ compare_at_price }}</span>
                  {%- endif -%}
                  <span class="best-seller-card__price-sale">{{ price }}</span>
                </div>
                {%- assign card_variant_id = product.selected_or_first_available_variant.id -%}
                <div class="best-seller-card__action">
                  {%- if card_variant_id != blank -%}
                    <form method="post" action="/cart/add" class="best-seller-card__buy-form">
                      <input type="hidden" name="id" value="{{ card_variant_id }}">
                      <input type="hidden" name="return_to" value="/checkout">
                      <button type="submit" class="best-seller-card__buy-btn" aria-label="Add {{ title | escape }} to cart">
                        Add To Cart
                      </button>
                    </form>
                  {%- else -%}
                    <a href="{{ link }}" class="best-seller-card__buy-btn" aria-label="Add {{ title | escape }} to cart">
                      Add To Cart
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- elsif use_collection_products -%}
        {%- for product in source_collection.products limit: prod_limit -%}
          {%- liquid
            assign title = product.title
            assign link = product.url
            assign price = product.price | money
            assign compare_at_price = ''
            assign badge = ''
            if product.compare_at_price > product.price
              assign compare_at_price = product.compare_at_price | money
              assign save_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
              assign badge = '✦ SAVE ' | append: save_pct | append: '%'
            endif
          -%}
          <li class="best-seller-item">
            <div class="best-seller-card">
              <a href="{{ link }}" class="best-seller-card__media-wrapper" aria-label="{{ title | escape }}">
                {%- if badge != blank -%}
                  <span class="best-seller-card__badge">{{ badge }}</span>
                {%- endif -%}
                <div class="best-seller-card__media">
                  {%- if product.featured_image != blank -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | default: title | escape }}"
                      loading="lazy"
                      width="{{ product.featured_image.width }}"
                      height="{{ product.featured_image.height }}"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              </a>
              <div class="best-seller-card__info">
                <h3 class="best-seller-card__title">
                  <a href="{{ link }}">{{ title }}</a>
                </h3>
                <div class="best-seller-card__price-wrapper">
                  {%- if compare_at_price != blank -%}
                    <span class="best-seller-card__price-compare">{{ compare_at_price }}</span>
                  {%- endif -%}
                  <span class="best-seller-card__price-sale">{{ price }}</span>
                </div>
                {%- assign card_variant_id = product.selected_or_first_available_variant.id -%}
                <div class="best-seller-card__action">
                  {%- if card_variant_id != blank -%}
                    <form method="post" action="/cart/add" class="best-seller-card__buy-form">
                      <input type="hidden" name="id" value="{{ card_variant_id }}">
                      <input type="hidden" name="return_to" value="/checkout">
                      <button type="submit" class="best-seller-card__buy-btn" aria-label="Add {{ title | escape }} to cart">
                        Add To Cart
                      </button>
                    </form>
                  {%- else -%}
                    <a href="{{ link }}" class="best-seller-card__buy-btn" aria-label="Add {{ title | escape }} to cart">
                      Add To Cart
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="best-sellers__button-wrapper" style="text-align: center; margin-top: 36px;">
        <a
          href="{{ section.settings.button_link | default: '/collections/all' }}"
          class="best-sellers__view-all-btn"
          style="
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background-color: #0045ff;
            color: #ffffff;
            font-size: 15px;
            font-weight: 700;
            padding: 12px 36px;
            border-radius: 8px;
            text-decoration: none;
            box-shadow: 0 4px 14px rgba(0, 69, 255, 0.35);
            transition: opacity 0.2s ease, transform 0.1s ease;
          "
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Best Sellers Grid",
  "tag": "section",
  "class": "section section-best-sellers",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Our Best Sellers",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Pulls live products from Shopify admin. Leave empty to use All products. Product card blocks override this when set."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Number of products to show"
    },
    {
      "type": "checkbox",
      "id": "title_center",
      "label": "Center Heading",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small (h2)"
        },
        {
          "value": "h1",
          "label": "Medium (h1)"
        },
        {
          "value": "h0",
          "label": "Large (h0)"
        }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on Desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2 Columns"
        }
      ],
      "default": "2",
      "label": "Columns on Mobile"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 16,
      "unit": "px",
      "label": "Image Corner Radius"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "View All Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label (e.g. View all)"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Image Asset Filename (e.g. bestseller_vivi_cap.jpg)"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text (e.g. ✦ SAVE 50%)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Sale Price (e.g. $32.30)"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare at Price (e.g. $64.60)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Grid",
      "blocks": [
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        }
      ]
    }
  ]
}
{% endschema %}
